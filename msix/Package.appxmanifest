<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Замените Name и Publisher на значения из Microsoft Partner Center (Store) или вашего сертификата -->
  <Identity
    Name="BuhlyOpenSource.BuhlyDesktop"
    Publisher="CN=BuhlyOpenSource"
    Version="3.2.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Buhly — Помощник бизнеса РБ</DisplayName>
    <PublisherDisplayName>Maxim Repin (@narard)</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ru-RU" />
  </Resources>

  <Applications>
    <Application Id="BuhlyApp"
      Executable="Buhly.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Buhly"
        Description="Локальный помощник селлера и малого бизнеса РБ: WB/Ozon, налоги (УСН и ИП), ТН-2/БСО, выписка любого банка и госпорталы в 1 клик"
        BackgroundColor="#007AFF"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
